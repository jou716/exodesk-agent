APP_ENV=development
DEMO_MODE=true

# Local demo uses MySQL. The database and user must already exist.
DATABASE_URL=mysql+pymysql://workorder_app:CHANGE_ME@127.0.0.1:3306/workorder_agent?charset=utf8mb4
CHROMA_PATH=./data/chroma

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_MAX_BYTES=1000000
SSE_POLL_SECONDS=0.2
SSE_HEARTBEAT_SECONDS=10

# mock = local MySQL demo provider. zendesk = read-only Zendesk adapter.
TICKET_PROVIDER=mock
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_SERIAL_FIELD_ID=
ZENDESK_TIMEOUT_SECONDS=15

# Optional. The demo runs deterministically when disabled.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TIMEOUT_SECONDS=35

AGENT_MAX_TOOL_CALLS=5
AGENT_TIMEOUT_SECONDS=90
TOOL_TIMEOUT_SECONDS=15
CONTEXT_MAX_CHARS=12000
CONTEXT_RECENT_MESSAGES=8

